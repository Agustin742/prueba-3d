{
  "name": "integratec-final-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "server:start": "pnpm.cmd --filter server start:dev",
    "server:build": "pnpm.cmd --filter server build",
    "db:up": "docker compose up -d",
    "db:migrate": "pnpm.cmd --filter server prisma:migrate"
  },
  "dependencies": {
    "@react-three/fiber": "9.1.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "socket.io-client": "^4.8.4",
    "three": "0.176.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/node": "22.15.21",
    "@types/react": "19.1.5",
    "@types/react-dom": "19.1.5",
    "@types/three": "0.176.0",
    "@vitejs/plugin-react": "4.4.1",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.1.3"
  }
}
